      "amber": "#F5A524",
      "mist": "#F4F6FB",
      "ink": "#1A1A1A",
      "white": "#FFFFFF"
    },
    "assets": [
      {"filename": "logo-primary.svg", "kind": "logo", "width": 400, "height": 100},
      {"filename": "logo-mono.svg", "kind": "logo", "width": 400, "height": 100},
      {"filename": "icon.png", "kind": "icon", "width": 256, "height": 256}
    ],
    "logo_ratio_tolerance": 0.05,
    "min_image_width": 600
  }
